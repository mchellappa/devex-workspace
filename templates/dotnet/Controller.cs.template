using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;
using {{namespace}}.DTOs;
using {{namespace}}.Services;

namespace {{namespace}}.Controllers;

[ApiController]
[Route("api/[controller]")]
[Authorize]
public class {{className}}Controller : ControllerBase
{
    private readonly I{{serviceName}} _{{serviceNameCamel}};
    private readonly ILogger<{{className}}Controller> _logger;

    public {{className}}Controller(
        I{{serviceName}} {{serviceNameCamel}},
        ILogger<{{className}}Controller> logger)
    {
        _{{serviceNameCamel}} = {{serviceNameCamel}};
        _logger = logger;
    }

    /// <summary>
    /// Get all {{resourceName}} items
    /// </summary>
    [HttpGet]
    [ProducesResponseType(typeof(IEnumerable<{{className}}Response>), StatusCodes.Status200OK)]
    public async Task<ActionResult<IEnumerable<{{className}}Response>>> GetAll()
    {
        _logger.LogInformation("Getting all {{resourceName}} items");
        var items = await _{{serviceNameCamel}}.GetAllAsync();
        return Ok(items);
    }

    /// <summary>
    /// Get {{resourceName}} by ID
    /// </summary>
    [HttpGet("{id}")]
    [ProducesResponseType(typeof({{className}}Response), StatusCodes.Status200OK)]
    [ProducesResponseType(StatusCodes.Status404NotFound)]
    public async Task<ActionResult<{{className}}Response>> GetById(int id)
    {
        _logger.LogInformation("Getting {{resourceName}} with ID: {Id}", id);
        var item = await _{{serviceNameCamel}}.GetByIdAsync(id);
        
        if (item == null)
        {
            return NotFound(new { message = $"{{resourceName}} with ID {id} not found" });
        }

        return Ok(item);
    }

    /// <summary>
    /// Create a new {{resourceName}}
    /// </summary>
    [HttpPost]
    [ProducesResponseType(typeof({{className}}Response), StatusCodes.Status201Created)]
    [ProducesResponseType(StatusCodes.Status400BadRequest)]
    public async Task<ActionResult<{{className}}Response>> Create([FromBody] {{className}}Request request)
    {
        _logger.LogInformation("Creating new {{resourceName}}");
        var item = await _{{serviceNameCamel}}.CreateAsync(request);
        return CreatedAtAction(nameof(GetById), new { id = item.Id }, item);
    }

    /// <summary>
    /// Update an existing {{resourceName}}
    /// </summary>
    [HttpPut("{id}")]
    [ProducesResponseType(typeof({{className}}Response), StatusCodes.Status200OK)]
    [ProducesResponseType(StatusCodes.Status404NotFound)]
    [ProducesResponseType(StatusCodes.Status400BadRequest)]
    public async Task<ActionResult<{{className}}Response>> Update(int id, [FromBody] {{className}}Request request)
    {
        _logger.LogInformation("Updating {{resourceName}} with ID: {Id}", id);
        var item = await _{{serviceNameCamel}}.UpdateAsync(id, request);
        
        if (item == null)
        {
            return NotFound(new { message = $"{{resourceName}} with ID {id} not found" });
        }

        return Ok(item);
    }

    /// <summary>
    /// Delete a {{resourceName}}
    /// </summary>
    [HttpDelete("{id}")]
    [ProducesResponseType(StatusCodes.Status204NoContent)]
    [ProducesResponseType(StatusCodes.Status404NotFound)]
    public async Task<IActionResult> Delete(int id)
    {
        _logger.LogInformation("Deleting {{resourceName}} with ID: {Id}", id);
        var success = await _{{serviceNameCamel}}.DeleteAsync(id);
        
        if (!success)
        {
            return NotFound(new { message = $"{{resourceName}} with ID {id} not found" });
        }

        return NoContent();
    }
}
