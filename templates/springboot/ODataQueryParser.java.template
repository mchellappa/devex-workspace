     * @param params the request parameter map (from {@code @RequestParam Map<String, String>})
     * @return parsed OData query options
     */
    public ODataQueryOptions parse(Map<String, String> params) {
        ODataQueryOptions options = new ODataQueryOptions();

        if (params == null || params.isEmpty()) {
            return options;
        }

        // $filter
        String filter = getParam(params, "$filter");
        if (filter != null) {
            options.setFilter(filter);
            log.debug("Parsed $filter: {}", filter);
        }

        // $orderby
        String orderby = getParam(params, "$orderby");
        if (orderby != null) {
            options.setOrderby(orderby);
            log.debug("Parsed $orderby: {}", orderby);
        }

        // $top
        String top = getParam(params, "$top");
        if (top != null) {
            try {
                options.setTop(Integer.parseInt(top));
                log.debug("Parsed $top: {}", options.getTop());
            } catch (NumberFormatException e) {
                log.warn("Invalid $top value '{}', using default", top);
            }
        }

        // $skip
        String skip = getParam(params, "$skip");
        if (skip != null) {
            try {
                options.setSkip(Integer.parseInt(skip));
                log.debug("Parsed $skip: {}", options.getSkip());
            } catch (NumberFormatException e) {
                log.warn("Invalid $skip value '{}', using default", skip);
            }
        }

        // $select
        String select = getParam(params, "$select");
        if (select != null) {
            List<String> fields = Arrays.stream(select.split(","))
                    .map(String::trim)
                    .filter(s -> !s.isEmpty())
                    .collect(Collectors.toList());
            options.setSelect(fields);
            log.debug("Parsed $select: {}", fields);
        }

        // $expand
        String expand = getParam(params, "$expand");
        if (expand != null) {
            List<String> relations = Arrays.stream(expand.split(","))
                    .map(String::trim)
                    .filter(s -> !s.isEmpty())
                    .collect(Collectors.toList());
            options.setExpand(relations);
            log.debug("Parsed $expand: {}", relations);
        }

        // $count
        String count = getParam(params, "$count");
        if (count != null) {
            options.setCount("true".equalsIgnoreCase(count));
            log.debug("Parsed $count: {}", options.isCount());
        }

        return options;
    }

    /**
     * Retrieves a parameter value, supporting both {@code $param} and {@code param} formats.
     */
    private String getParam(Map<String, String> params, String key) {
        String value = params.get(key);
        if (value == null) {
