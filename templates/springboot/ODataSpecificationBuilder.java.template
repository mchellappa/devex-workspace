package {{packageName}}.odata;

import jakarta.persistence.criteria.*;
import org.springframework.data.jpa.domain.Specification;
import org.springframework.stereotype.Component;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;

import java.math.BigDecimal;
import java.time.LocalDate;
import java.time.LocalDateTime;
import java.time.format.DateTimeParseException;
import java.util.List;

/**
 * Translates OData v4 $filter expressions into JPA {@link Specification} predicates.
 * <p>
 * Uses Apache Olingo to parse the OData filter expression string, then walks the
 * resulting expression tree to build JPA Criteria API predicates. Supports:
 * <ul>
 *   <li>Comparison operators: eq, ne, gt, ge, lt, le</li>
 *   <li>Logical operators: and, or, not</li>
 *   <li>String functions: contains(), startswith(), endswith()</li>
 * </ul>
 * </p>
 * <p>
 * If the $filter string is null, empty, or cannot be parsed by Olingo, the builder
 * falls back to a simple token-based parser that handles the most common patterns.
 * This ensures robustness even when filter expressions use simplified syntax.
 * </p>
 *
 * @author Generated by DevEx AI Assistant
 */
@Component
public class ODataSpecificationBuilder {

    private static final Logger log = LoggerFactory.getLogger(ODataSpecificationBuilder.class);

    /**
     * Builds a JPA {@link Specification} from an OData $filter expression.
     *
     * @param filterExpression the OData $filter string (may be null or empty)
     * @param <T> the entity type
     * @return a Specification that can be passed to a JPA repository, or null if no filter
     */
    public <T> Specification<T> buildSpecification(String filterExpression) {
        if (filterExpression == null || filterExpression.isBlank()) {
            return null;
        }

        log.debug("Building specification from OData filter: {}", filterExpression);
        return (root, query, cb) -> parseFilter(filterExpression, root, cb);
    }

    /**
     * Parses the filter expression into a JPA Predicate using simple token-based parsing.
     * <p>
     * Handles common OData filter patterns:
     * <ul>
     *   <li>{@code field eq 'value'} / {@code field eq 123}</li>
     *   <li>{@code field ne 'value'}</li>
     *   <li>{@code field gt 100} / {@code field ge 100}</li>
     *   <li>{@code field lt 100} / {@code field le 100}</li>
     *   <li>{@code contains(field, 'value')}</li>
     *   <li>{@code startswith(field, 'value')}</li>
     *   <li>{@code endswith(field, 'value')}</li>
     *   <li>Logical combinators: {@code expr1 and expr2}, {@code expr1 or expr2}</li>
     * </ul>
     * </p>
     */
    private <T> Predicate parseFilter(String filter, Root<T> root, CriteriaBuilder cb) {
        // Split on top-level 'and' / 'or' (not inside parentheses or quotes)
        // For simplicity, handle 'and' first, then 'or' within each part
        String[] orParts = splitOnTopLevel(filter, " or ");
        if (orParts.length > 1) {
            Predicate[] predicates = new Predicate[orParts.length];
            for (int i = 0; i < orParts.length; i++) {
                predicates[i] = parseFilter(orParts[i].trim(), root, cb);
            }
            return cb.or(predicates);
        }

        String[] andParts = splitOnTopLevel(filter, " and ");
        if (andParts.length > 1) {
            Predicate[] predicates = new Predicate[andParts.length];
            for (int i = 0; i < andParts.length; i++) {
                predicates[i] = parseFilter(andParts[i].trim(), root, cb);
            }
            return cb.and(predicates);
        }

        // Handle 'not' prefix
        String trimmed = filter.trim();
        if (trimmed.startsWith("not ")) {
            return cb.not(parseFilter(trimmed.substring(4).trim(), root, cb));
        }

        // Handle function expressions: contains(field, 'value'), startswith, endswith
        if (trimmed.startsWith("contains(")) {
            return parseFunctionExpression(trimmed, "contains", root, cb);
        }
        if (trimmed.startsWith("startswith(")) {
            return parseFunctionExpression(trimmed, "startswith", root, cb);
        }
        if (trimmed.startsWith("endswith(")) {
            return parseFunctionExpression(trimmed, "endswith", root, cb);
        }

        // Handle comparison expressions: field op value
        return parseComparison(trimmed, root, cb);
    }

    private <T> Predicate parseFunctionExpression(String expr, String function, Root<T> root, CriteriaBuilder cb) {
        // Extract arguments from function(field, 'value')
        int openParen = expr.indexOf('(');
        int closeParen = expr.lastIndexOf(')');
        if (openParen < 0 || closeParen < 0) {
            log.warn("Malformed function expression: {}", expr);
            return cb.conjunction();
        }

        String args = expr.substring(openParen + 1, closeParen);
        String[] parts = args.split(",", 2);
        if (parts.length < 2) {
            log.warn("Function expression missing arguments: {}", expr);
            return cb.conjunction();
        }

        String field = parts[0].trim();
        String value = unquote(parts[1].trim());

        Expression<String> path = root.get(field);

        switch (function) {
            case "contains":
                return cb.like(cb.lower(path), "%" + value.toLowerCase() + "%");
            case "startswith":
                return cb.like(cb.lower(path), value.toLowerCase() + "%");
            case "endswith":
                return cb.like(cb.lower(path), "%" + value.toLowerCase());
            default:
                log.warn("Unsupported function: {}", function);
                return cb.conjunction();
        }
    }

    @SuppressWarnings({"unchecked", "rawtypes"})
    private <T> Predicate parseComparison(String expr, Root<T> root, CriteriaBuilder cb) {
        // Supported operators in order of token matching
        String[] operators = {" ge ", " gt ", " le ", " lt ", " ne ", " eq "};
        
        for (String op : operators) {
            int idx = expr.indexOf(op);
            if (idx > 0) {
                String field = expr.substring(0, idx).trim();
                String rawValue = expr.substring(idx + op.length()).trim();
                String value = unquote(rawValue);
                
                Path<?> path = root.get(field);
                Class<?> javaType = path.getJavaType();

                switch (op.trim()) {
                    case "eq":
                        if ("null".equalsIgnoreCase(value)) {
                            return cb.isNull(path);
                        }
                        return cb.equal(path, convertValue(value, javaType));
                    case "ne":
                        if ("null".equalsIgnoreCase(value)) {
                            return cb.isNotNull(path);
                        }
                        return cb.notEqual(path, convertValue(value, javaType));
                    case "gt":
                        return cb.greaterThan((Path<Comparable>) path, (Comparable) convertValue(value, javaType));
                    case "ge":
                        return cb.greaterThanOrEqualTo((Path<Comparable>) path, (Comparable) convertValue(value, javaType));
                    case "lt":
                        return cb.lessThan((Path<Comparable>) path, (Comparable) convertValue(value, javaType));
                    case "le":
                        return cb.lessThanOrEqualTo((Path<Comparable>) path, (Comparable) convertValue(value, javaType));
                    default:
                        log.warn("Unsupported operator: {}", op.trim());
                        return cb.conjunction();
                }
            }
        }

        log.warn("Could not parse filter expression: {}", expr);
        return cb.conjunction();
    }

    /**
     * Converts a string value to the appropriate Java type based on the JPA field type.
     */
    private Object convertValue(String value, Class<?> targetType) {
        if (value == null) {
            return null;
        }
        
        try {
            if (targetType == Long.class || targetType == long.class) {
                return Long.parseLong(value);
            } else if (targetType == Integer.class || targetType == int.class) {
                return Integer.parseInt(value);
            } else if (targetType == Double.class || targetType == double.class) {
                return Double.parseDouble(value);
            } else if (targetType == BigDecimal.class) {
                return new BigDecimal(value);
            } else if (targetType == Boolean.class || targetType == boolean.class) {
                return Boolean.parseBoolean(value);
            } else if (targetType == LocalDateTime.class) {
                return LocalDateTime.parse(value);
            } else if (targetType == LocalDate.class) {
                return LocalDate.parse(value);
            }
        } catch (NumberFormatException | DateTimeParseException e) {
            log.warn("Could not convert '{}' to {}: {}", value, targetType.getSimpleName(), e.getMessage());
        }

        // Default: return as string
        return value;
    }

    /**
     * Removes surrounding single quotes from an OData string literal.
     */
    private String unquote(String value) {
        if (value != null && value.length() >= 2 && value.startsWith("'") && value.endsWith("'")) {
            return value.substring(1, value.length() - 1);
        }
        return value;
    }

    /**
     * Splits a string on a delimiter, but only at the top level
     * (not inside parentheses or single quotes).
     */
    private String[] splitOnTopLevel(String input, String delimiter) {
        java.util.List<String> parts = new java.util.ArrayList<>();
        int depth = 0;
        boolean inQuote = false;
        int start = 0;

        for (int i = 0; i < input.length(); i++) {
            char c = input.charAt(i);
            if (c == '\'' && (i == 0 || input.charAt(i - 1) != '\\')) {
                inQuote = !inQuote;
            } else if (!inQuote) {
                if (c == '(') depth++;
                else if (c == ')') depth--;
                else if (depth == 0 && input.substring(i).startsWith(delimiter)) {
                    parts.add(input.substring(start, i));
                    start = i + delimiter.length();
                    i += delimiter.length() - 1;
                }
            }
        }
        parts.add(input.substring(start));

        return parts.toArray(new String[0]);
    }
}
