package {{packageName}}.odata;

import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.HttpHeaders;
import org.springframework.http.MediaType;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RestController;
import io.swagger.v3.oas.annotations.Operation;
import io.swagger.v3.oas.annotations.tags.Tag;

import jakarta.servlet.http.HttpServletRequest;
import java.util.Map;

/**
 * OData v4 metadata and service document controller.
 * <p>
 * Provides the required endpoints for OData v4 service discovery:
 * <ul>
 *   <li>{@code GET /} - Service document listing available entity sets</li>
 *   <li>{@code GET /$metadata} - EDMX document describing the entity data model</li>
 * </ul>
 * </p>
 * <p>
 * These endpoints are required for Salesforce Connect OData v4 adapter
 * and other OData-compliant clients to discover the service schema.
 * </p>
 *
 * @author Generated by DevEx AI Assistant
 * @version 1.0
 */
@RestController
@Tag(name = "OData Service", description = "OData v4 service document and metadata endpoints")
public class ODataMetadataController {

    private static final Logger log = LoggerFactory.getLogger(ODataMetadataController.class);
    private static final String ODATA_VERSION = "4.0";

    private final ODataEdmProvider edmProvider;

    @Autowired
    public ODataMetadataController(ODataEdmProvider edmProvider) {
        this.edmProvider = edmProvider;
    }

    /**
     * OData v4 service document.
     * <p>
     * Returns a JSON document listing all available entity sets.
     * This is the entry point for OData clients like Salesforce Connect.
     * </p>
     *
     * @param request the HTTP request (used to build base URL)
     * @return JSON service document with entity set listing
     */
    @GetMapping(value = "/", produces = "application/json;odata.metadata=minimal;charset=utf-8")
    @Operation(
        summary = "OData Service Document",
        description = "Lists all available OData entity sets. Entry point for OData v4 clients."
    )
    public ResponseEntity<Map<String, Object>> getServiceDocument(HttpServletRequest request) {
        log.info("OData service document requested");

        String baseUrl = buildBaseUrl(request);
        Map<String, Object> serviceDoc = edmProvider.generateServiceDocument(baseUrl);

        HttpHeaders headers = odataHeaders();
        headers.set(HttpHeaders.CONTENT_TYPE, "application/json;odata.metadata=minimal;charset=utf-8");

        return ResponseEntity.ok().headers(headers).body(serviceDoc);
    }

    /**
     * OData v4 $metadata endpoint.
     * <p>
     * Returns the Entity Data Model (EDMX) as XML, describing all entity types,
     * their properties, keys, and entity sets. This is required for Salesforce
     * Connect's "Validate and Sync" operation.
     * </p>
     *
     * @return EDMX XML document
     */
    @GetMapping(value = "/$metadata", produces = "application/xml;charset=utf-8")
    @Operation(
        summary = "OData $metadata",
        description = "Returns the OData v4 Entity Data Model (EDMX) describing all entity types and sets."
    )
    public ResponseEntity<String> getMetadata() {
        log.info("OData $metadata requested");

        String edmx = edmProvider.generateMetadataXml();

        HttpHeaders headers = odataHeaders();
        headers.set(HttpHeaders.CONTENT_TYPE, "application/xml;charset=utf-8");

        return ResponseEntity.ok().headers(headers).body(edmx);
    }

    /**
     * Build OData response headers required by the spec.
     * Salesforce Connect validates the OData-Version header on every response.
     */
    private HttpHeaders odataHeaders() {
        HttpHeaders headers = new HttpHeaders();
        headers.set("OData-Version", ODATA_VERSION);
        return headers;
    }

    /**
     * Build the base URL from the current request.
     * Strips the path to get the scheme + host + context-path.
     */
    private String buildBaseUrl(HttpServletRequest request) {
        String scheme = request.getScheme();
        String serverName = request.getServerName();
        int serverPort = request.getServerPort();
        String contextPath = request.getContextPath();

        StringBuilder url = new StringBuilder();
        url.append(scheme).append("://").append(serverName);

        // Only include port if non-standard
        if (("http".equals(scheme) && serverPort != 80) ||
            ("https".equals(scheme) && serverPort != 443)) {
            url.append(":").append(serverPort);
        }

        url.append(contextPath);
        return url.toString();
    }
}
