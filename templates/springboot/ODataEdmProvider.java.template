package {{packageName}}.odata;

import jakarta.persistence.*;
import jakarta.persistence.metamodel.EntityType;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.stereotype.Component;

import java.lang.reflect.Field;
import java.math.BigDecimal;
import java.time.*;
import java.util.*;
import java.util.stream.Collectors;

/**
 * OData v4 Entity Data Model (EDM) provider.
 * <p>
 * Scans all JPA {@code @Entity} classes via the JPA metamodel and builds
 * an in-memory representation of the OData EDM. This is used to generate:
 * <ul>
 *   <li>The {@code $metadata} EDMX document (XML)</li>
 *   <li>The service document (JSON)</li>
 * </ul>
 * </p>
 * <p>
 * Java-to-EDM type mappings follow the OData v4 (OASIS) specification.
 * </p>
 *
 * @author Generated by DevEx AI Assistant
 * @version 1.0
 */
@Component
public class ODataEdmProvider {

    private static final Logger log = LoggerFactory.getLogger(ODataEdmProvider.class);

    private static final String EDM_NAMESPACE = "{{packageName}}";
    private static final String CONTAINER_NAME = "DefaultContainer";

    private final EntityManager entityManager;
    private List<EdmEntityType> entityTypes;

    public ODataEdmProvider(EntityManager entityManager) {
        this.entityManager = entityManager;
    }

    /**
     * Get all discovered entity types. Lazily initializes on first call.
     */
    public List<EdmEntityType> getEntityTypes() {
        if (entityTypes == null) {
            entityTypes = discoverEntityTypes();
        }
        return entityTypes;
    }

    /**
     * Get the EDM namespace.
     */
    public String getNamespace() {
        return EDM_NAMESPACE;
    }

    /**
     * Get the entity container name.
     */
    public String getContainerName() {
        return CONTAINER_NAME;
    }

    /**
     * Generate the $metadata EDMX XML document.
     */
    public String generateMetadataXml() {
        List<EdmEntityType> types = getEntityTypes();
        StringBuilder xml = new StringBuilder();

        xml.append("<?xml version=\"1.0\" encoding=\"utf-8\"?>\n");
        xml.append("<edmx:Edmx Version=\"4.0\" xmlns:edmx=\"http://docs.oasis-open.org/odata/ns/edmx\">\n");
        xml.append("  <edmx:DataServices>\n");
        xml.append("    <Schema Namespace=\"").append(EDM_NAMESPACE)
           .append("\" xmlns=\"http://docs.oasis-open.org/odata/ns/edm\">\n\n");

        // Entity Types
        for (EdmEntityType type : types) {
            xml.append("      <EntityType Name=\"").append(type.getName()).append("\">\n");

            // Key
            if (type.getKeyPropertyName() != null) {
                xml.append("        <Key>\n");
                xml.append("          <PropertyRef Name=\"").append(type.getKeyPropertyName()).append("\"/>\n");
                xml.append("        </Key>\n");
            }

            // Properties
            for (EdmProperty prop : type.getProperties()) {
                xml.append("        <Property Name=\"").append(prop.getName())
                   .append("\" Type=\"").append(prop.getEdmType()).append("\"");
                if (!prop.isNullable()) {
                    xml.append(" Nullable=\"false\"");
                } else {
                    xml.append(" Nullable=\"true\"");
                }
                if (prop.getMaxLength() != null) {
                    xml.append(" MaxLength=\"").append(prop.getMaxLength()).append("\"");
                }
                if (prop.getPrecision() != null) {
                    xml.append(" Precision=\"").append(prop.getPrecision()).append("\"");
                }
                if (prop.getScale() != null) {
                    xml.append(" Scale=\"").append(prop.getScale()).append("\"");
                }
                xml.append("/>\n");
            }

            xml.append("      </EntityType>\n\n");
        }

        // Entity Container
        xml.append("      <EntityContainer Name=\"").append(CONTAINER_NAME).append("\">\n");
        for (EdmEntityType type : types) {
            xml.append("        <EntitySet Name=\"").append(type.getEntitySetName())
               .append("\" EntityType=\"").append(EDM_NAMESPACE).append(".").append(type.getName()).append("\"/>\n");
        }
        xml.append("      </EntityContainer>\n\n");

        xml.append("    </Schema>\n");
        xml.append("  </edmx:DataServices>\n");
        xml.append("</edmx:Edmx>\n");

        return xml.toString();
    }

    /**
     * Generate the OData service document JSON.
     */
    public Map<String, Object> generateServiceDocument(String baseUrl) {
        List<EdmEntityType> types = getEntityTypes();

        Map<String, Object> doc = new LinkedHashMap<>();
        doc.put("@odata.context", baseUrl + "/$metadata");

        List<Map<String, String>> entitySets = new ArrayList<>();
        for (EdmEntityType type : types) {
            Map<String, String> entry = new LinkedHashMap<>();
            entry.put("name", type.getEntitySetName());
            entry.put("kind", "EntitySet");
            entry.put("url", type.getEntitySetName());
            entitySets.add(entry);
        }
        doc.put("value", entitySets);

        return doc;
    }

    /**
     * Discover all JPA entity types and map them to EDM entity types.
     */
    private List<EdmEntityType> discoverEntityTypes() {
        Set<EntityType<?>> jpaEntities = entityManager.getMetamodel().getEntities();
        List<EdmEntityType> types = new ArrayList<>();

        for (EntityType<?> jpaEntity : jpaEntities) {
            try {
                Class<?> javaType = jpaEntity.getJavaType();
                EdmEntityType edmType = mapEntityType(jpaEntity.getName(), javaType);
                if (edmType != null) {
                    types.add(edmType);
                    log.info("Mapped JPA entity to OData: {} -> EntitySet '{}'",
                            javaType.getSimpleName(), edmType.getEntitySetName());
                }
            } catch (Exception e) {
                log.warn("Failed to map JPA entity {}: {}", jpaEntity.getName(), e.getMessage());
            }
        }

        // Sort by name for deterministic output
        types.sort(Comparator.comparing(EdmEntityType::getName));
        log.info("OData EDM: discovered {} entity types", types.size());
        return types;
    }

    /**
     * Map a single JPA entity class to an EDM entity type.
     */
    private EdmEntityType mapEntityType(String entityName, Class<?> javaType) {
        List<EdmProperty> properties = new ArrayList<>();
        String keyPropertyName = null;

        // Walk the class hierarchy to pick up inherited fields
        Class<?> currentClass = javaType;
        while (currentClass != null && currentClass != Object.class) {
            for (Field field : currentClass.getDeclaredFields()) {
                // Skip static and transient fields
                if (java.lang.reflect.Modifier.isStatic(field.getModifiers()) ||
                    java.lang.reflect.Modifier.isTransient(field.getModifiers()) ||
                    field.isAnnotationPresent(Transient.class)) {
                    continue;
                }

                // Check if this is the ID field
                boolean isKey = field.isAnnotationPresent(Id.class);
                if (isKey) {
                    keyPropertyName = field.getName();
                }

                // Map Java type to EDM type
                String edmType = javaTypeToEdmType(field.getType());
                if (edmType == null) {
                    log.debug("Skipping unmappable field {}.{} of type {}",
                            entityName, field.getName(), field.getType().getSimpleName());
                    continue;
                }

                // Determine nullability
                boolean nullable = !isKey;
                Column columnAnn = field.getAnnotation(Column.class);
                if (columnAnn != null) {
                    nullable = columnAnn.nullable();
                }

                // Determine max length for strings
                Integer maxLength = null;
                if ("Edm.String".equals(edmType) && columnAnn != null && columnAnn.length() != 255) {
                    maxLength = columnAnn.length();
                }

                // Determine precision/scale for decimals
                Integer precision = null;
                Integer scale = null;
                if ("Edm.Decimal".equals(edmType) && columnAnn != null) {
                    if (columnAnn.precision() > 0) {
                        precision = columnAnn.precision();
                    }
                    if (columnAnn.scale() > 0) {
                        scale = columnAnn.scale();
                    }
                }

                properties.add(new EdmProperty(field.getName(), edmType, nullable, maxLength, precision, scale));
            }
            currentClass = currentClass.getSuperclass();
        }

        if (properties.isEmpty()) {
            log.warn("Entity {} has no mappable properties, skipping", entityName);
            return null;
        }

        // Entity set name is the plural form of the entity name
        String entitySetName = pluralize(entityName);

        return new EdmEntityType(entityName, entitySetName, keyPropertyName, properties);
    }

    /**
     * Map Java types to OData EDM primitive types.
     */
    private String javaTypeToEdmType(Class<?> javaType) {
        if (javaType == String.class) return "Edm.String";
        if (javaType == Long.class || javaType == long.class) return "Edm.Int64";
        if (javaType == Integer.class || javaType == int.class) return "Edm.Int32";
        if (javaType == Short.class || javaType == short.class) return "Edm.Int16";
        if (javaType == Double.class || javaType == double.class) return "Edm.Double";
        if (javaType == Float.class || javaType == float.class) return "Edm.Single";
        if (javaType == Boolean.class || javaType == boolean.class) return "Edm.Boolean";
        if (javaType == BigDecimal.class) return "Edm.Decimal";
        if (javaType == LocalDateTime.class || javaType == OffsetDateTime.class || javaType == Instant.class) return "Edm.DateTimeOffset";
        if (javaType == LocalDate.class) return "Edm.Date";
        if (javaType == LocalTime.class) return "Edm.TimeOfDay";
        if (javaType == UUID.class) return "Edm.Guid";
        if (javaType == byte[].class || javaType == Byte[].class) return "Edm.Binary";
        return null; // Unmappable complex types (relationships, etc.)
    }

    /**
     * Simple English pluralization for entity set names.
     */
    private String pluralize(String name) {
        if (name == null || name.isEmpty()) return name;
        String lower = name.toLowerCase();
        if (lower.endsWith("s") || lower.endsWith("x") || lower.endsWith("ch") || lower.endsWith("sh")) {
            return name + "es";
        }
        if (lower.endsWith("y") && name.length() > 1 && !isVowel(name.charAt(name.length() - 2))) {
            return name.substring(0, name.length() - 1) + "ies";
        }
        return name + "s";
    }

    private boolean isVowel(char c) {
        return "aeiouAEIOU".indexOf(c) >= 0;
    }

    // ── Inner classes ────────────────────────────────────────────────────

    /**
     * Represents an OData EntityType in the EDM.
     */
    public static class EdmEntityType {
        private final String name;
        private final String entitySetName;
        private final String keyPropertyName;
        private final List<EdmProperty> properties;

        public EdmEntityType(String name, String entitySetName, String keyPropertyName, List<EdmProperty> properties) {
            this.name = name;
            this.entitySetName = entitySetName;
            this.keyPropertyName = keyPropertyName;
            this.properties = properties;
        }

        public String getName() { return name; }
        public String getEntitySetName() { return entitySetName; }
        public String getKeyPropertyName() { return keyPropertyName; }
        public List<EdmProperty> getProperties() { return properties; }
    }

    /**
     * Represents a property in an OData EntityType.
     */
    public static class EdmProperty {
        private final String name;
        private final String edmType;
        private final boolean nullable;
        private final Integer maxLength;
        private final Integer precision;
        private final Integer scale;

        public EdmProperty(String name, String edmType, boolean nullable, Integer maxLength, Integer precision, Integer scale) {
            this.name = name;
            this.edmType = edmType;
            this.nullable = nullable;
            this.maxLength = maxLength;
            this.precision = precision;
            this.scale = scale;
        }

        public String getName() { return name; }
        public String getEdmType() { return edmType; }
        public boolean isNullable() { return nullable; }
        public Integer getMaxLength() { return maxLength; }
        public Integer getPrecision() { return precision; }
        public Integer getScale() { return scale; }
    }
}
