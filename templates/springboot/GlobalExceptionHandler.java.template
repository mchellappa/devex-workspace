package {{packageName}}.exception;

import org.springframework.beans.factory.annotation.Value;
import org.springframework.http.HttpHeaders;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.validation.FieldError;
import org.springframework.web.bind.MethodArgumentNotValidException;
import org.springframework.web.bind.annotation.ExceptionHandler;
import org.springframework.web.bind.annotation.RestControllerAdvice;
import org.springframework.web.context.request.WebRequest;
import org.springframework.web.method.annotation.MethodArgumentTypeMismatchException;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;

import jakarta.servlet.http.HttpServletRequest;
import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Map;
import java.util.UUID;
import java.util.stream.Collectors;

/**
 * Global exception handler for all REST controllers.
 * <p>
 * This class uses @RestControllerAdvice to intercept exceptions thrown by
 * controllers and convert them into appropriate HTTP responses. This ensures
 * consistent error response format across the entire API.
 * </p>
 * <p>
 * Error Response Format (JSON API style):
 * <pre>
 * {
 *   "errors": [
 *     {
 *       "id": "<uuid-v4>",
 *       "status": "400",
 *       "title": "Bad Request",
 *       "code": "VALIDATION_ERROR",
 *       "detail": "First name is required"
 *     }
 *   ]
 * }
 * </pre>
 * </p>
 * <p>
 * All error responses include the standard response headers:
 * Cache-Control, X-B3-Trace-Id, Manulife-Api-Version.
 * </p>
 *
 * @author Generated by DevEx AI Assistant
 * @version 1.0
 */
@RestControllerAdvice
public class GlobalExceptionHandler {

    private static final Logger log = LoggerFactory.getLogger(GlobalExceptionHandler.class);

    @Value("${spring.application.version:1.0.0}")
    private String applicationVersion;

    /**
     * Builds a single error object in the JSON API error format.
     */
    private Map<String, Object> buildError(String code, String title, String detail, HttpStatus status) {
        Map<String, Object> error = new HashMap<>();
        error.put("id", UUID.randomUUID().toString());
        error.put("status", String.valueOf(status.value()));
        error.put("title", title);
        error.put("code", code);
        error.put("detail", detail);
        return error;
    }

    /**
     * Builds standard response headers for all error responses.
     */
    private HttpHeaders buildErrorHeaders(HttpServletRequest httpRequest) {
        HttpHeaders headers = new HttpHeaders();
        headers.set("Cache-Control", "no-cache");
        String traceId = httpRequest.getHeader("X-B3-Trace-Id");
        headers.set("X-B3-Trace-Id", traceId != null ? traceId : UUID.randomUUID().toString());
        headers.set("Manulife-Api-Version", applicationVersion);
        return headers;
    }

    /**
     * Handles Jakarta Bean Validation exceptions (@Valid on request bodies).
     * Returns 400 Bad Request with field-level validation errors.
     *
     * @param ex the validation exception
     * @param request the web request
     * @param httpRequest the HTTP servlet request
     * @return response with validation error details
     */
    @ExceptionHandler(MethodArgumentNotValidException.class)
    public ResponseEntity<Map<String, List<Map<String, Object>>>> handleValidationExceptions(
            MethodArgumentNotValidException ex, WebRequest request, HttpServletRequest httpRequest) {
        
        List<Map<String, Object>> errors = new ArrayList<>();
        ex.getBindingResult().getFieldErrors().forEach(fieldError -> {
            String detail = fieldError.getField() + ": " +
                (fieldError.getDefaultMessage() != null ? fieldError.getDefaultMessage() : "Invalid value");
            errors.add(buildError("VALIDATION_ERROR", "Bad Request", detail, HttpStatus.BAD_REQUEST));
        });
        
        log.warn("Validation failed for request: {} - {} error(s)", request.getDescription(false), errors.size());
        
        Map<String, List<Map<String, Object>>> body = new HashMap<>();
        body.put("errors", errors);
        
        return ResponseEntity.badRequest()
            .headers(buildErrorHeaders(httpRequest))
            .body(body);
    }

    /**
     * Handles type mismatch exceptions (e.g., string passed for Long path variable).
     * Returns 400 Bad Request with clear error message.
     *
     * @param ex the type mismatch exception
     * @param request the web request
     * @param httpRequest the HTTP servlet request
     * @return response with type mismatch error details
     */
    @ExceptionHandler(MethodArgumentTypeMismatchException.class)
    public ResponseEntity<Map<String, List<Map<String, Object>>>> handleTypeMismatch(
            MethodArgumentTypeMismatchException ex, WebRequest request, HttpServletRequest httpRequest) {
        
        String detail = String.format(
            "Invalid value '%s' for parameter '%s'. Expected type: %s",
            ex.getValue(),
            ex.getName(),
            ex.getRequiredType() != null ? ex.getRequiredType().getSimpleName() : "unknown"
        );
        
        log.warn("Type mismatch in request: {} - {}", request.getDescription(false), detail);
        
        Map<String, List<Map<String, Object>>> body = new HashMap<>();
        body.put("errors", List.of(buildError("TYPE_MISMATCH", "Bad Request", detail, HttpStatus.BAD_REQUEST)));
        
        return ResponseEntity.badRequest()
            .headers(buildErrorHeaders(httpRequest))
            .body(body);
    }

    /**
     * Handles IllegalArgumentException from input validation (e.g., Assert.notNull).
     * Returns 400 Bad Request.
     *
     * @param ex the illegal argument exception
     * @param request the web request
     * @param httpRequest the HTTP servlet request
     * @return response with validation error
     */
    @ExceptionHandler(IllegalArgumentException.class)
    public ResponseEntity<Map<String, List<Map<String, Object>>>> handleIllegalArgument(
            IllegalArgumentException ex, WebRequest request, HttpServletRequest httpRequest) {
        
        log.warn("Invalid argument in request: {} - {}", request.getDescription(false), ex.getMessage());
        
        Map<String, List<Map<String, Object>>> body = new HashMap<>();
        body.put("errors", List.of(buildError("INVALID_ARGUMENT", "Bad Request", ex.getMessage(), HttpStatus.BAD_REQUEST)));
        
        return ResponseEntity.badRequest()
            .headers(buildErrorHeaders(httpRequest))
            .body(body);
    }

    /**
     * Handles custom ApplicationException (base class for business exceptions).
     * Returns the HTTP status specified in the exception.
     *
     * @param ex the application exception
     * @param request the web request
     * @param httpRequest the HTTP servlet request
     * @return response with application error details
     */
    @ExceptionHandler(ApplicationException.class)
    public ResponseEntity<Map<String, List<Map<String, Object>>>> handleApplicationException(
            ApplicationException ex, WebRequest request, HttpServletRequest httpRequest) {
        
        log.error("Application error in request: {} - {} (Code: {})",
            request.getDescription(false), ex.getMessage(), ex.getErrorCode());
        
        Map<String, List<Map<String, Object>>> body = new HashMap<>();
        body.put("errors", List.of(buildError(ex.getErrorCode(), ex.getStatus().getReasonPhrase(), ex.getMessage(), ex.getStatus())));
        
        return ResponseEntity.status(ex.getStatus())
            .headers(buildErrorHeaders(httpRequest))
            .body(body);
    }

    /**
     * Handles ResourceNotFoundException (thrown when entity not found by ID).
     * Returns 404 Not Found.
     *
     * @param ex the resource not found exception
     * @param request the web request
     * @param httpRequest the HTTP servlet request
     * @return response with not found error details
     */
    @ExceptionHandler(ResourceNotFoundException.class)
    public ResponseEntity<Map<String, List<Map<String, Object>>>> handleResourceNotFoundException(
            ResourceNotFoundException ex, WebRequest request, HttpServletRequest httpRequest) {
        
        log.warn("Resource not found in request: {} - {}", request.getDescription(false), ex.getMessage());
        
        Map<String, List<Map<String, Object>>> body = new HashMap<>();
        body.put("errors", List.of(buildError("RESOURCE_NOT_FOUND", "Not Found", ex.getMessage(), HttpStatus.NOT_FOUND)));
        
        return ResponseEntity.status(HttpStatus.NOT_FOUND)
            .headers(buildErrorHeaders(httpRequest))
            .body(body);
    }

    /**
     * Handles BusinessValidationException (custom business rule violations).
     * Returns 400 Bad Request.
     *
     * @param ex the business validation exception
     * @param request the web request
     * @param httpRequest the HTTP servlet request
     * @return response with business validation error
     */
    @ExceptionHandler(BusinessValidationException.class)
    public ResponseEntity<Map<String, List<Map<String, Object>>>> handleBusinessValidationException(
            BusinessValidationException ex, WebRequest request, HttpServletRequest httpRequest) {
        
        log.warn("Business validation error in request: {} - {}", request.getDescription(false), ex.getMessage());
        
        Map<String, List<Map<String, Object>>> body = new HashMap<>();
        body.put("errors", List.of(buildError(ex.getErrorCode(), "Bad Request", ex.getMessage(), HttpStatus.BAD_REQUEST)));
        
        return ResponseEntity.badRequest()
            .headers(buildErrorHeaders(httpRequest))
            .body(body);
    }

    /**
     * Handles all uncaught exceptions as a fallback.
     * Returns 500 Internal Server Error with generic message.
     * <p>
     * IMPORTANT: Details are logged but not exposed to clients for security.
     * </p>
     *
     * @param ex the unexpected exception
     * @param request the web request
     * @param httpRequest the HTTP servlet request
     * @return response with generic error message
     */
    @ExceptionHandler(Exception.class)
    public ResponseEntity<Map<String, List<Map<String, Object>>>> handleGlobalException(
            Exception ex, WebRequest request, HttpServletRequest httpRequest) {
        
        log.error("Unexpected error in request: {} - Exception: {}", 
            request.getDescription(false), ex.getClass().getName(), ex);
        // Note: Do NOT expose ex.getMessage() in production - security risk
        
        Map<String, List<Map<String, Object>>> body = new HashMap<>();
        body.put("errors", List.of(buildError(
            "INTERNAL_SERVER_ERROR",
            "Internal Server Error",
            "An unexpected error occurred. Please contact support if the problem persists.",
            HttpStatus.INTERNAL_SERVER_ERROR
        )));
        
        return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR)
            .headers(buildErrorHeaders(httpRequest))
            .body(body);
    }
}
